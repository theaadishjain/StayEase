<% layout("layouts/boilerplate") %>
<% block("title", listing.title) %>
<%
  const isOwner = currUser && listing.owner && listing.owner._id.equals(currUser._id);
  const reviews = listing.reviews || [];
  const avgRating = reviews.length
    ? reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviews.length
    : 0;
  const hostName = listing.owner ? listing.owner.username : null;
%>

<header class="show-header">
  <a href="/listings" class="d-inline-flex align-items-center gap-2 mb-3 text-decoration-none text-muted-soft small fw-semibold">
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All stays
  </a>
  <h1><%= listing.title %></h1>
  <div class="show-sub">
    <% if (reviews.length) { %>
      <span><i class="fa-solid fa-star" aria-hidden="true"></i>
        <strong class="text-body"><%= avgRating.toFixed(1) %></strong>
        (<%= reviews.length %> <%= reviews.length === 1 ? "review" : "reviews" %>)</span>
      <span class="dot"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i><%= listing.location %>, <%= listing.country %></span>
    <% } else { %>
      <span><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i><%= listing.location %>, <%= listing.country %></span>
    <% } %>
  </div>
</header>

<div class="show-hero">
  <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
</div>

<div class="row gx-4 gx-xl-5 gy-0">
  <div class="col-lg-7">
    <div class="host-row">
      <span class="avatar avatar-lg" aria-hidden="true"><%= hostName ? hostName.charAt(0) : "S" %></span>
      <div>
        <h2>Hosted by <%= hostName || "StayEase" %></h2>
        <span class="text-muted-soft small"><%= listing.location %>, <%= listing.country %></span>
      </div>
    </div>

    <section class="section">
      <h2 class="section-title">About this place</h2>
      <p class="description mb-0"><%= listing.description %></p>
    </section>
  </div>

  <div class="col-lg-5 col-xl-4 offset-xl-1">
    <aside class="booking-card">
      <div class="price-line">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %> <span>/ night</span></div>

      <ul class="fact-list">
        <li><span>Location</span><span><%= listing.location %></span></li>
        <li><span>Country</span><span><%= listing.country %></span></li>
        <li><span>Rating</span><span><%= reviews.length ? avgRating.toFixed(1) + " / 5" : "No reviews yet" %></span></li>
      </ul>

      <% if (isOwner) { %>
        <p class="small text-muted-soft mb-2">You're the host of this listing.</p>
        <div class="d-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark flex-fill">
            <i class="fa-solid fa-pen me-1" aria-hidden="true"></i> Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-fill">
            <button class="btn btn-outline-danger-soft w-100">
              <i class="fa-solid fa-trash me-1" aria-hidden="true"></i> Delete
            </button>
          </form>
        </div>
      <% } else { %>
        <a href="#reviews" class="btn btn-brand w-100">Read reviews</a>
      <% } %>
    </aside>
  </div>
</div>

<!-- REVIEWS -->
<section class="section mt-4 border-top" id="reviews">
  <div class="rating-summary">
    <i class="fa-solid fa-star" aria-hidden="true"></i>
    <% if (reviews.length) { %>
      <%= avgRating.toFixed(1) %> · <%= reviews.length %> <%= reviews.length === 1 ? "review" : "reviews" %>
    <% } else { %>
      Reviews
    <% } %>
  </div>

  <% if (reviews.length) { %>
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
      <% for (let review of reviews) { %>
        <% const author = review.author ? review.author.username : "Guest"; %>
        <div class="col">
          <article class="review-card">
            <div class="who">
              <span class="avatar" aria-hidden="true"><%= author.charAt(0) %></span>
              <div>
                <strong><%= author %></strong>
                <% if (review.createdAt) { %>
                  <small><%= new Date(review.createdAt).toLocaleDateString("en-IN", { month: "long", year: "numeric" }) %></small>
                <% } %>
              </div>
            </div>
            <div class="stars" role="img" aria-label="Rated <%= review.rating %> out of 5">
              <% for (let i = 1; i <= 5; i++) { %><i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i><% } %>
            </div>
            <p><%= review.comment %></p>
            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-soft">Delete</button>
              </form>
            <% } %>
          </article>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <p class="text-muted-soft mb-4">No reviews yet. Be the first to share your experience.</p>
  <% } %>

  <% if (currUser) { %>
    <div class="review-form">
      <h3 class="h5 mb-3">Leave a review</h3>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <span class="form-label d-block" id="ratingLabel">Your rating</span>
          <fieldset class="star-rating" aria-labelledby="ratingLabel">
            <% for (let i = 5; i >= 1; i--) { %>
              <input type="radio" id="rate-<%= i %>" name="review[rating]" value="<%= i %>" required>
              <label for="rate-<%= i %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>">
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                <span class="visually-hidden"><%= i %> star<%= i > 1 ? "s" : "" %></span>
              </label>
            <% } %>
          </fieldset>
          <div class="invalid-feedback">Please pick a rating</div>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Your review</label>
          <textarea name="review[comment]" id="comment" rows="4" class="form-control"
                    placeholder="What did you like? What could be better?" required></textarea>
          <div class="invalid-feedback">Please write a few words about your stay</div>
        </div>

        <button class="btn btn-dark">Submit review</button>
      </form>
    </div>
  <% } else { %>
    <div class="login-prompt">
      <span>Stayed here? Log in to share your experience.</span>
      <a href="/login" class="btn btn-dark">Log in to review</a>
    </div>
  <% } %>
</section>
