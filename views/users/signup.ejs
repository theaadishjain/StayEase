<% layout("layouts/boilerplate") %>
<% block("title", "Sign up") %>

<div class="auth-shell">
  <div class="text-center mb-4">
    <span class="brand-mark"><i class="fa-regular fa-compass" aria-hidden="true"></i></span>
    <h1>Create your account</h1>
    <p class="text-muted-soft mb-0">Join StayEase to host places and review your stays.</p>
  </div>

  <form method="POST" action="/signup" novalidate class="needs-validation form-card">
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input id="username" name="username" type="text" class="form-control" autocomplete="username" required autofocus>
      <div class="invalid-feedback">Please choose a username</div>
    </div>

    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input id="email" name="email" type="email" class="form-control" autocomplete="email" required>
      <div class="invalid-feedback">Please enter a valid email</div>
    </div>

    <div class="mb-4">
      <label for="password" class="form-label">Password</label>
      <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" required>
      <div class="invalid-feedback">Please enter a password</div>
    </div>

    <button class="btn btn-brand w-100">Sign up</button>
  </form>

  <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
</div>
