<% layout("layouts/boilerplate") %>
<% block("title", "Log in") %>

<div class="auth-shell">
  <div class="text-center mb-4">
    <span class="brand-mark"><i class="fa-regular fa-compass" aria-hidden="true"></i></span>
    <h1>Welcome back</h1>
    <p class="text-muted-soft mb-0">Log in to manage your listings and reviews.</p>
  </div>

  <form method="POST" action="/login" novalidate class="needs-validation form-card">
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input id="username" name="username" type="text" class="form-control" autocomplete="username" required autofocus>
      <div class="invalid-feedback">Please enter your username</div>
    </div>

    <div class="mb-4">
      <label for="password" class="form-label">Password</label>
      <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required>
      <div class="invalid-feedback">Please enter your password</div>
    </div>

    <button class="btn btn-brand w-100">Log in</button>
  </form>

  <p class="auth-switch">New to StayEase? <a href="/signup">Create an account</a></p>
</div>
